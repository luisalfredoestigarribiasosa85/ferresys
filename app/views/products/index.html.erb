<% content_for(:page_title) { "Productos" } %>

<%= render "shared/page_header", title: "Productos", subtitle: "#{@products.unscope(:limit).count} registros", action:
  link_to("Nuevo producto", new_product_path, class: button_classes) %>

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
  <%= form_with url: products_path, method: :get, class: "flex flex-1 gap-2" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nombre o código…", class: field_classes %>
    <%= form.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "Todas las categorías" }, class: field_classes %>
    <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @products.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-3 font-semibold">Código</th>
            <th class="px-5 py-3 font-semibold">Producto</th>
            <th class="px-5 py-3 font-semibold">Categoría</th>
            <th class="px-5 py-3 text-right font-semibold">Precio</th>
            <th class="px-5 py-3 text-right font-semibold">Stock</th>
            <th class="px-5 py-3 font-semibold">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @products.each do |product| %>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-3 font-mono text-xs text-slate-500"><%= product.sku.presence || "—" %></td>
              <td class="px-5 py-3">
                <%= link_to product.name, product, class: "font-medium text-slate-900 hover:text-blue-600" %>
              </td>
              <td class="px-5 py-3 text-slate-500"><%= product.category&.name || "—" %></td>
              <td class="px-5 py-3 text-right font-medium"><%= money(product.price) %></td>
              <td class="px-5 py-3 text-right">
                <span class="<%= product.low_stock? ? "font-bold text-red-600" : "text-slate-700" %>">
                  <%= product.stock %> <%= product.unit %>
                </span>
              </td>
              <td class="px-5 py-3">
                <% if product.active? %>
                  <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">Activo</span>
                <% else %>
                  <span class="rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">Inactivo</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay productos. ¡Creá tu primer producto!" %>
  <% end %>
</div>