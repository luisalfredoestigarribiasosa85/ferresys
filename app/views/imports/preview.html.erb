<% content_for(:page_title) { "Revisar importación" } %>

<%= render "shared/page_header", title: "Revisar importación", subtitle: "Validación de tu archivo CSV" %>

<% valid_count = @importer.valid_rows.count %>
<% error_rows = @importer.rows.select { |r| r[:errors].present? } %>

<div class="grid gap-4 sm:grid-cols-3">
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Filas totales</p>
    <p class="mt-2 text-2xl font-bold text-slate-900"><%= @importer.rows.count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Correctas (se importarán)</p>
    <p class="mt-2 text-2xl font-bold text-emerald-600"><%= valid_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Con errores</p>
    <p class="mt-2 text-2xl font-bold <%= error_rows.any? ? "text-red-600" : "text-slate-900" %>"><%= error_rows.count %></p>
  </div>
</div>

<div class="mt-6 <%= card_classes %> overflow-hidden">
  <div class="border-b border-slate-200 px-5 py-4">
    <h3 class="font-semibold text-slate-900">Vista previa</h3>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-5 py-3 font-semibold">Fila</th>
          <th class="px-5 py-3 font-semibold">Nombre</th>
          <th class="px-5 py-3 font-semibold">Categoría</th>
          <th class="px-5 py-3 text-right font-semibold">Costo</th>
          <th class="px-5 py-3 text-right font-semibold">Precio</th>
          <th class="px-5 py-3 text-right font-semibold">Stock</th>
          <th class="px-5 py-3 font-semibold">Estado</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @importer.rows.first(200).each do |row| %>
          <tr class="<%= row[:errors].present? ? "bg-red-50" : "" %>">
            <td class="px-5 py-2.5 text-slate-400"><%= row[:index] %></td>
            <td class="px-5 py-2.5 font-medium text-slate-900"><%= row[:attrs][ "nombre" ].presence || "—" %></td>
            <td class="px-5 py-2.5 text-slate-600"><%= row[:attrs][ "categoria" ].presence || "" %></td>
            <td class="px-5 py-2.5 text-right text-slate-600"><%= money(row[:attrs][ "costo" ].to_i) %></td>
            <td class="px-5 py-2.5 text-right text-slate-600"><%= money(row[:attrs][ "precio" ].to_i) %></td>
            <td class="px-5 py-2.5 text-right text-slate-600"><%= row[:attrs][ "stock" ] %></td>
            <td class="px-5 py-2.5">
              <% if row[:errors].present? %>
                <span class="text-xs font-semibold text-red-600" title="<%= row[:errors].join(", ") %>">Error</span>
              <% else %>
                <span class="text-xs font-semibold text-emerald-600">Ok</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @importer.rows.count > 200 %>
    <p class="border-t border-slate-200 px-5 py-3 text-xs text-slate-500">Mostrando las primeras 200 filas de <%= @importer.rows.count %>.</p>
  <% end %>
</div>

<% if error_rows.any? %>
  <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
    <p class="font-semibold">Resumen de errores por fila</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-5">
      <% error_rows.first(20).each do |row| %>
        <li><span class="font-mono text-xs">Fila <%= row[:index] %></span> — <%= row[:errors].join(", ") %></li>
      <% end %>
      <% if error_rows.count > 20 %>
        <li>… y <%= error_rows.count - 20 %> filas más.</li>
      <% end %>
    </ul>
    <p class="mt-2 text-xs">Las filas con errores se omitirán; el resto se importará correctamente.</p>
  </div>
<% end %>

<div class="mt-6 flex flex-wrap items-center justify-end gap-3">
  <%= link_to "Volver", new_import_path, class: button_classes(:secondary) %>
  <%= form_with url: imports_path, class: "inline-flex gap-3" do |form| %>
    <%= form.hidden_field :confirm, value: "1" %>
    <%= form.hidden_field :csv_content, value: @importer.original_content %>
    <%= form.submit "Importar #{valid_count} producto(s)", class: button_classes, disabled: valid_count.zero?, data: { turbo_submits_with: "Importando…" } %>
  <% end %>
</div>
