<% content_for(:page_title) { "Cuentas por cobrar" } %>

<%= render "shared/page_header", title: "Cuentas por cobrar", subtitle: "Pagos de clientes",
  action: link_to("Registrar pago", new_payment_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: payments_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :from, "Desde", class: label_classes %>
      <%= form.date_field :from, value: params[:from], class: field_classes %>
    </div>
    <div>
      <%= form.label :to, "Hasta", class: label_classes %>
      <%= form.date_field :to, value: params[:to], class: field_classes %>
    </div>
    <div>
      <%= form.label :customer_id, "Cliente", class: label_classes %>
      <%= form.collection_select :customer_id, @customers, :id, :name, { include_blank: "Todos", selected: params[:customer_id] }, class: field_classes %>
    </div>
    <%= form.submit "Filtrar", class: "#{button_classes(:secondary)} cursor-pointer" %>
    <%= link_to "Limpiar", payments_path, class: "text-sm font-medium text-slate-500 hover:text-slate-700" %>
  <% end %>
</div>

<% if @payments.any? %>
  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <div class="<%= card_classes %> p-5">
      <p class="text-sm font-medium text-slate-500">Pagos registrados</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= @payments.count %></p>
    </div>
    <div class="<%= card_classes %> p-5">
      <p class="text-sm font-medium text-slate-500">Total cobrado</p>
      <p class="mt-1 text-2xl font-bold text-emerald-600"><%= money(@payments.sum(:amount)) %></p>
    </div>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-3 font-semibold">Fecha</th>
            <th class="px-5 py-3 font-semibold">Cliente</th>
            <th class="px-5 py-3 font-semibold">Venta</th>
            <th class="px-5 py-3 font-semibold">Pago</th>
            <th class="px-5 py-3 text-right font-semibold">Monto</th>
            <th class="px-5 py-3 font-semibold">Registró</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @payments.each do |payment| %>
            <tr>
              <td class="px-5 py-3"><%= simple_date(payment.created_at) %></td>
              <td class="px-5 py-3 font-medium text-slate-900"><%= payment.customer.name %></td>
              <td class="px-5 py-3"><%= link_to "##{payment.sale.number}", sale_path(payment.sale), class: "font-mono text-xs text-blue-600 hover:text-blue-700" %></td>
              <td class="px-5 py-3 capitalize"><%= payment.payment_method %></td>
              <td class="px-5 py-3 text-right font-semibold"><%= money(payment.amount) %></td>
              <td class="px-5 py-3 text-slate-600"><%= payment.user&.name || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render "shared/empty_state", message: "No hay pagos registrados en este rango" %>
<% end %>