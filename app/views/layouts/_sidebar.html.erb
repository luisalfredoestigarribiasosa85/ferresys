<aside data-controller="sidebar" data-sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-slate-200 bg-slate-900 text-slate-300 lg:flex">
  <div class="flex h-16 items-center gap-2 px-5">
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-base font-bold text-white">F</div>
    <div>
      <p class="text-sm font-semibold text-white">Ferresys</p>
      <p class="text-xs text-slate-400">Ventas e inventario</p>
    </div>
  </div>

  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4 text-sm">
    <%= sidebar_link "Inicio", dashboard_index_path, icon: "dashboard" %>
    <%= sidebar_link "Ventas", sales_path, icon: "sales" %>
    <%= sidebar_link "Productos", products_path, icon: "products" %>
    <%= sidebar_link "Categorías", categories_path, icon: "categories" %>
    <%= sidebar_link "Clientes", customers_path, icon: "customers" %>
    <%= sidebar_link "Proveedores", suppliers_path, icon: "suppliers" %>
    <%= sidebar_link "Compras", purchases_path, icon: "cart" %>
    <%= sidebar_link "Movimientos", stock_movements_path, icon: "movements" %>
    <%= sidebar_link "Caja diaria", daily_cash_reports_path, icon: "reports" %>
    <% if current_user.owner? %>
      <%= sidebar_link "Empleados", employees_path, icon: "employees" %>
    <% end %>
  </nav>

  <div class="border-t border-slate-800 px-5 py-4">
    <p class="text-sm font-medium text-white"><%= current_account.name %></p>
    <p class="mt-0.5 text-xs text-slate-400"><%= current_user.name %> · <%= current_user.owner? ? "Dueño" : "Empleado" %></p>
    <%= button_to session_path, method: :delete, class: "mt-3 text-left text-xs font-medium text-slate-400 hover:text-white cursor-pointer" do %>
      Cerrar sesión
    <% end %>
  </div>
</aside>