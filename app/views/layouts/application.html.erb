<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Ferresys" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ferresys">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
    <% if logged_in? %>
      <div class="flex min-h-screen">
        <%= render "layouts/sidebar" %>

        <div class="flex flex-1 flex-col lg:pl-64">
          <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 lg:px-8">
            <div class="flex items-center gap-3">
              <button data-action="click->sidebar#toggle" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 lg:hidden" aria-label="Menú">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
              </button>
              <h1 class="text-lg font-semibold text-slate-800"><%= content_for(:page_title) || "Panel" %></h1>
            </div>

            <div class="hidden items-center gap-3 md:flex">
              <span class="text-sm text-slate-600"><%= current_account.name %></span>
              <span class="h-6 w-px bg-slate-200"></span>
              <span class="text-sm font-medium text-slate-800"><%= current_user.name %></span>
              <%= button_to session_path, method: :delete, class: "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-500 hover:bg-slate-100", data: { turbo_method: :delete } do %>
                Salir
              <% end %>
            </div>
          </header>

          <main class="flex-1 px-4 py-6 lg:px-8">
            <%= render "shared/flash" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="flex min-h-screen items-center justify-center px-4">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>