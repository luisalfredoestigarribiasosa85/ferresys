<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Ticket" %> · Ferresys</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      body { background: #e5e0d5; }
      .ticket-shell { display: flex; justify-content: center; padding: 24px; }
      .ticket { width: 80mm; max-width: 80mm; background: #fffdf8; color: #201d17; font-family: "Fragment Mono", ui-monospace, Menlo, Consolas, monospace; font-size: 11px; line-height: 1.45; padding: 16px; box-shadow: 0 10px 25px rgba(0,0,0,.18); border-top: 8px solid #201d17; }
      .ticket .hazardbar { height: 6px; background: repeating-linear-gradient(-45deg, #201d17 0 5px, #d9481c 5px 10px); margin-bottom: 10px; }
      .ticket .center { text-align: center; }
      .ticket .muted { color: #6b6659; }
      .ticket h1 { font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
      .ticket .row { display: flex; justify-content: space-between; gap: 8px; }
      .ticket .item { display: flex; justify-content: space-between; gap: 8px; }
      .ticket .item .desc { flex: 1; }
      .ticket .divider { border-top: 1px dashed #a39d90; margin: 8px 0; }
      .ticket .total { font-size: 15px; font-weight: 700; color: #d9481c; }
      .ticket table { width: 100%; border-collapse: collapse; }
      .ticket table td { padding: 2px 0; vertical-align: top; }
      .ticket table td.right { text-align: right; white-space: nowrap; }
      .no-print { text-align: center; padding: 8px 0 16px; }
      .no-print button { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 10px 22px; border-radius: 8px; background: #d9481c; color: #fff; border: 0; cursor: pointer; }
      .no-print button.secondary { background: #201d17; margin-left: 8px; }
      @media print {
        body { background: #fff; }
        .ticket-shell { padding: 0; }
        .ticket { box-shadow: none; padding: 0; border-top-width: 0; }
        .ticket .hazardbar { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .no-print { display: none; }
        @page { margin: 0; }
      }
    </style>
  </head>
  <body>
    <div class="no-print">
      <button onclick="window.print()">Imprimir</button>
      <button class="secondary" onclick="window.close()">Cerrar</button>
    </div>
    <div class="ticket-shell">
      <div class="ticket"><%= yield %></div>
    </div>
  </body>
</html>