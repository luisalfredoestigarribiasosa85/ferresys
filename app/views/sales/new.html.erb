<% content_for(:page_title) { "Nueva venta" } %>
<% catalog = @products.map { |p| { id: p.id, name: p.name, price: p.price, unit: p.unit, stock: p.stock } }.to_json %>

<script type="application/json" id="sale-catalog" data-turbo-cache="false"><%= catalog %></script>

<%= render "shared/form_errors", object: @sale %>

<%= form_with model: @sale, data: { controller: "sales" }, class: "grid items-start gap-6 xl:grid-cols-3" do |form| %>
  <div class="<%= card_classes %> p-6 xl:col-span-2">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :customer_id, "Cliente", class: label_classes %>
        <%= form.collection_select :customer_id, @customers, :id, :name, { include_blank: "Consumidor final" }, class: field_classes %>
      </div>
      <div>
        <%= form.label :payment_method, "Forma de pago", class: label_classes %>
        <%= form.select :payment_method, Sale.payment_methods.map { |k, _| [ k.titleize, k ] }, {}, class: field_classes %>
      </div>
    </div>

    <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-slate-400">Productos de la venta</h3>

    <div class="mt-2 hidden grid-cols-12 gap-2 px-4 text-xs font-semibold uppercase tracking-wide text-slate-400 sm:grid">
      <div class="col-span-6">Producto</div>
      <div class="col-span-2">Cant.</div>
      <div class="col-span-2">Precio</div>
      <div class="col-span-2 text-right">Subtotal</div>
    </div>

    <div data-sales-target="lines" class="mt-2 space-y-2">
      <%= form.fields_for :items, @sale.items do |item_form| %>
        <%= render "sales/item_fields", f: item_form %>
      <% end %>
    </div>

    <button type="button" data-action="sales#addLine" class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-700">
      + Agregar producto
    </button>

    <template data-sales-target="template">
      <%= form.fields_for :items, SaleItem.new, child_index: "__INDEX__" do |item_form| %>
        <%= render "sales/item_fields", f: item_form %>
      <% end %>
    </template>

    <div class="mt-6">
      <%= form.label :note, "Nota", class: label_classes %>
      <%= form.text_area :note, rows: 2, placeholder: "Comentario interno (no afecta el total)", class: field_classes %>
    </div>
  </div>

  <div class="<%= card_classes %> p-6 xl:col-span-1">
    <h3 class="font-semibold text-slate-900">Resumen de la venta</h3>

    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between">
        <dt class="text-slate-500">Artículos</dt>
        <dd data-sales-target="summaryCount" class="font-semibold text-slate-900">0</dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-slate-500">Subtotal</dt>
        <dd data-sales-target="summarySubtotal" class="font-semibold text-slate-900">0</dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-slate-500">Descuento</dt>
        <dd>
          <%= form.number_field :discount, step: "0.01", min: 0, value: @sale.discount || 0,
              class: "w-28 rounded-lg border border-slate-300 px-2 py-1.5 text-right text-sm",
              data: { sales_target: "discount", action: "input->sales#recalculate" } %>
        </dd>
      </div>
      <div class="flex items-end justify-between border-t border-slate-200 pt-3">
        <dt class="text-base font-semibold text-slate-900">Total</dt>
        <dd data-sales-target="summaryTotal" class="text-2xl font-bold text-slate-900">0</dd>
      </div>
    </dl>

    <div class="mt-6 flex gap-3">
      <%= link_to "Cancelar", sales_path, class: button_classes(:secondary) %>
      <%= form.submit "Registrar venta", class: button_classes, data: { turbo_submits_with: "Guardando…" } %>
    </div>

    <p class="mt-4 text-xs text-slate-400">El precio se carga automáticamente al elegir el producto y el stock se descuenta al registrar la venta.</p>
  </div>
<% end %>