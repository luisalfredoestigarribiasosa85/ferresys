<% content_for(:page_title) { "Ventas" } %>

<%= render "shared/page_header", title: "Ventas", subtitle: "Registro de operaciones", action:
  link_to("Nueva venta", new_sale_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: sales_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :from, "Desde", class: label_classes %>
      <%= form.date_field :from, value: params[:from], class: field_classes %>
    </div>
    <div>
      <%= form.label :to, "Hasta", class: label_classes %>
      <%= form.date_field :to, value: params[:to], class: field_classes %>
    </div>
    <div>
      <%= form.label :status, "Estado", class: label_classes %>
      <%= form.select :status, Sale.statuses.map { |k, _| [ k.titleize, k ] }, { include_blank: "Todos", selected: params[:status] }, class: field_classes %>
    </div>
    <%= form.submit "Filtrar", class: button_classes(:secondary) %>
    <%= link_to "Limpiar", sales_path, class: "text-sm font-medium text-slate-500 hover:text-slate-700" %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @sales.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-3 font-semibold">N°</th>
            <th class="px-5 py-3 font-semibold">Fecha</th>
            <th class="px-5 py-3 font-semibold">Cliente</th>
            <th class="px-5 py-3 font-semibold">Pago</th>
            <th class="px-5 py-3 text-right font-semibold">Total</th>
            <th class="px-5 py-3 font-semibold">Estado</th>
            <th class="px-5 py-3 text-right"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @sales.each do |sale| %>
            <tr class="hover:bg-slate-50 <%= sale.cancelled? ? "text-slate-400 line-through" : "" %>">
              <td class="px-5 py-3 font-mono text-xs">#<%= sale.number %></td>
              <td class="px-5 py-3"><%= simple_date(sale.created_at) %></td>
              <td class="px-5 py-3"><%= sale.customer&.name.presence || "Consumidor final" %></td>
              <td class="px-5 py-3 capitalize"><%= sale.payment_method %></td>
              <td class="px-5 py-3 text-right font-semibold"><%= money(sale.total) %></td>
              <td class="px-5 py-3">
                <% if sale.completed? %>
                  <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">Completada</span>
                <% else %>
                  <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">Anulada</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-right">
                <%= link_to "Ver", sale, class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No hay ventas en este rango" %>
  <% end %>
</div>