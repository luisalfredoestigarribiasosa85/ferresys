<% content_for(:page_title) { "Caja diaria" } %>

<%= render "shared/page_header", title: "Caja diaria", subtitle: simple_date(@date) %>

<div class="mb-4">
  <%= form_with url: daily_cash_reports_path, method: :get, class: "flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :date, "Fecha", class: label_classes %>
      <%= form.date_field :date, value: params[:date], class: field_classes %>
    </div>
    <%= form.submit "Ver", class: "#{button_classes(:secondary)} cursor-pointer" %>
  <% end %>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Ventas del día</p>
    <p class="mt-2 text-2xl font-bold text-slate-900"><%= @sale_count %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Ingreso total</p>
    <p class="mt-2 text-2xl font-bold text-emerald-600"><%= money(@total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Descuentos aplicados</p>
    <p class="mt-2 text-2xl font-bold text-red-600"><%= money(@discount_total) %></p>
  </div>
  <div class="<%= card_classes %> p-5">
    <p class="text-sm font-medium text-slate-500">Clientes con compra</p>
    <p class="mt-2 text-2xl font-bold text-slate-900"><%= @customer_count %></p>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <h3 class="font-semibold text-slate-900">Desglose por forma de pago</h3>
    </div>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-slate-100">
        <% @by_payment.each do |method, amount| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 capitalize text-slate-700"><%= method %></td>
            <td class="px-5 py-3 text-right font-semibold text-slate-900"><%= money(amount) %></td>
          </tr>
        <% end %>
        <tr class="border-t-2 border-slate-200 bg-slate-50">
          <td class="px-5 py-3 font-semibold text-slate-900">Total</td>
          <td class="px-5 py-3 text-right text-base font-bold text-emerald-600"><%= money(@total) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="<%= card_classes %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <h3 class="font-semibold text-slate-900">Ventas del día</h3>
    </div>
    <% if @sales.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-5 py-3 font-semibold">N°</th>
              <th class="px-5 py-3 font-semibold">Hora</th>
              <th class="px-5 py-3 font-semibold">Cliente</th>
              <th class="px-5 py-3 font-semibold">Pago</th>
              <th class="px-5 py-3 text-right font-semibold">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @sales.each do |sale| %>
              <tr class="hover:bg-slate-50">
                <td class="px-5 py-3 font-mono text-xs">#<%= sale.number %></td>
                <td class="px-5 py-3 text-slate-500"><%= sale.created_at.strftime("%H:%M") %></td>
                <td class="px-5 py-3"><%= link_to (sale.customer&.name || "Consumidor final"), sale, class: "text-slate-900 hover:text-blue-600" %></td>
                <td class="px-5 py-3 capitalize text-slate-700"><%= sale.payment_method %></td>
                <td class="px-5 py-3 text-right font-semibold text-slate-900"><%= money(sale.total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "No hubo ventas en esta fecha" %>
    <% end %>
  </div>
</div>
