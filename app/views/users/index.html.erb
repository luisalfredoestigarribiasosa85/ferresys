<% content_for(:page_title) { "Empleados" } %>

<%= render "shared/page_header", title: "Empleados", subtitle: "Usuarios con acceso a la cuenta", action:
  link_to("Agregar empleado", new_employee_path, class: button_classes) %>

<div class="<%= card_classes %> overflow-hidden">
  <% if @users.any? %>
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-5 py-3 font-semibold">Nombre</th>
          <th class="px-5 py-3 font-semibold">Email</th>
          <th class="px-5 py-3 font-semibold">Rol</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= user.name %></td>
            <td class="px-5 py-3 text-slate-500"><%= user.email %></td>
            <td class="px-5 py-3">
              <% if user.owner? %>
                <span class="rounded-full bg-slate-900 px-2.5 py-1 text-xs font-semibold text-white">Dueño</span>
              <% else %>
                <span class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700">Empleado</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render "shared/empty_state", message: "No hay empleados" %>
  <% end %>
</div>