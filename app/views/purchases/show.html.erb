<% content_for(:page_title) { "Compra ##{@purchase.number}" } %>

<%= render "shared/page_header", title: "Compra ##{@purchase.number}",
  subtitle: simple_date(@purchase.created_at),
  action: link_to("Volver", purchases_path, class: button_classes(:secondary)) %>

<div class="<%= card_classes %> overflow-hidden">
  <div class="border-b border-slate-200 px-5 py-4">
    <dl class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <div class="flex gap-2"><dt class="font-medium text-slate-500">Proveedor</dt><dd class="font-semibold text-slate-900"><%= @purchase.supplier&.name || "—" %></dd></div>
      <div class="flex gap-2"><dt class="font-medium text-slate-500">Registró</dt><dd class="text-slate-700"><%= @purchase.user&.name || "—" %></dd></div>
      <div class="flex gap-2"><dt class="font-medium text-slate-500">Nota</dt><dd class="text-slate-700"><%= @purchase.note.presence || "—" %></dd></div>
    </dl>
  </div>

  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
      <tr>
        <th class="px-5 py-3 font-semibold">Producto</th>
        <th class="px-5 py-3 text-right font-semibold">Cantidad</th>
        <th class="px-5 py-3 text-right font-semibold">Costo unit.</th>
        <th class="px-5 py-3 text-right font-semibold">Subtotal</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @purchase.items.each do |item| %>
        <tr class="hover:bg-slate-50">
          <td class="px-5 py-3"><%= link_to item.product.name, item.product, class: "font-medium text-slate-900 hover:text-blue-600" %></td>
          <td class="px-5 py-3 text-right text-slate-700"><%= item.quantity %> <%= item.product.unit %></td>
          <td class="px-5 py-3 text-right text-slate-700"><%= money(item.unit_cost) %></td>
          <td class="px-5 py-3 text-right font-semibold"><%= money(item.line_subtotal) %></td>
        </tr>
      <% end %>
      <tr class="border-t-2 border-slate-200 bg-slate-50">
        <td class="px-5 py-3 font-semibold text-slate-900" colspan="3">Total</td>
        <td class="px-5 py-3 text-right text-base font-bold text-emerald-600"><%= money(@purchase.total) %></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="mt-4">
  <%= link_to "Ver movimientos de stock", stock_movements_path(movement_type: "purchase"), class: button_classes(:secondary) %>
</div>
