<% content_for(:page_title) { "Proveedores" } %>

<%= render "shared/page_header", title: "Proveedores", subtitle: "#{@suppliers.count} proveedores", action:
  link_to("Nuevo proveedor", new_supplier_path, class: button_classes) %>

<div class="mb-4">
  <%= form_with url: suppliers_path, method: :get, class: "flex max-w-md gap-2" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Buscar por nombre o RUC…", class: field_classes %>
    <%= form.submit "Buscar", class: button_classes(:secondary) %>
  <% end %>
</div>

<div class="<%= card_classes %> overflow-hidden">
  <% if @suppliers.any? %>
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-5 py-3 font-semibold">Nombre</th>
          <th class="px-5 py-3 font-semibold">RUC</th>
          <th class="px-5 py-3 font-semibold">Teléfono</th>
          <th class="px-5 py-3 font-semibold">Email</th>
          <th class="px-5 py-3 text-right"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @suppliers.each do |supplier| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3 font-medium text-slate-900"><%= supplier.name %></td>
            <td class="px-5 py-3 font-mono text-xs text-slate-500"><%= supplier.ruc.presence || "—" %></td>
            <td class="px-5 py-3 text-slate-500"><%= supplier.phone.presence || "—" %></td>
            <td class="px-5 py-3 text-slate-500"><%= supplier.email.presence || "—" %></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <%= link_to "Editar", edit_supplier_path(supplier), class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
              <%= button_to "Eliminar", supplier, method: :delete,
                  data: { turbo_confirm: "¿Eliminar a #{supplier.name}?" },
                  class: "ml-3 inline text-sm font-medium text-red-600 hover:text-red-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render "shared/empty_state", message: "No hay proveedores todavía" %>
  <% end %>
</div>