<% if notice %>
  <div data-controller="flash" data-flash-auto-hide-value="true" class="mb-4 flex items-center justify-between rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
    <span><%= notice %></span>
    <button data-action="flash#dismiss" class="text-emerald-500 hover:text-emerald-700" aria-label="Cerrar">✕</button>
  </div>
<% end %>

<% if alert && alert.is_a?(String) %>
  <div class="mb-4 flex items-center justify-between rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800">
    <span><%= alert %></span>
    <button data-action="flash#dismiss" class="text-orange-500 hover:text-orange-700" aria-label="Cerrar">✕</button>
  </div>
<% end %>