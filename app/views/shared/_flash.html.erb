<% if notice %>
  <div data-controller="flash" data-flash-auto-hide-value="true"
       class="mb-4 flex items-center justify-between gap-3 rounded-lg border border-ok/25 bg-ok-soft px-4 py-3 text-sm text-ok reveal">
    <span class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <%= notice %>
    </span>
    <button data-action="flash#dismiss" class="text-ok/60 hover:text-ok" aria-label="Cerrar">✕</button>
  </div>
<% end %>

<% if alert && alert.is_a?(String) %>
  <div data-controller="flash"
       class="mb-4 flex items-center justify-between gap-3 rounded-lg border border-alert/25 bg-alert-soft px-4 py-3 text-sm text-alert reveal">
    <span class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
      <%= alert %>
    </span>
    <button data-action="flash#dismiss" class="text-alert/60 hover:text-alert" aria-label="Cerrar">✕</button>
  </div>
<% end %>